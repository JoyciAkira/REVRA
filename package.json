{
  "name": "revra",
  "private": true,
  "version": "0.1.0",
  "description": "REVRA — Enterprise Reverse Engineering Platform (PRD v2.0 Beyond Limits)",
  "packageManager": "pnpm@12.3.4",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @revra/api start:dev",
    "dev:web": "pnpm --filter @revra/web dev",
    "typecheck": "pnpm -r build && pnpm -r typecheck"
  }
}
